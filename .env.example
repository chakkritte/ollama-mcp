OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY
DEFAULT_MODEL=gpt-oss:120b

# --- Sub-agent settings (all optional) ---
# Directory the agents are confined to (default: server's working directory)
# OLLAMA_AGENT_WORKSPACE=/absolute/path/to/project
# Hard opt-in for dangerous tool groups; agent_run must ALSO request them
# OLLAMA_AGENT_ALLOW_WRITE=0
# OLLAMA_AGENT_ALLOW_SHELL=0
# Comma-separated command prefixes (matched per token, no pipes/redirects)
# OLLAMA_AGENT_SHELL_ALLOWLIST=ls,cat,head,tail,wc,grep,rg,git status,git diff,git log,git show,pytest,python -m pytest
# OLLAMA_AGENT_MAX_CONCURRENT=4
# OLLAMA_AGENT_MAX_STEPS=20
# OLLAMA_AGENT_TIMEOUT=600
# OLLAMA_REQUEST_TIMEOUT=120
# OLLAMA_AGENT_SHELL_TIMEOUT=60
